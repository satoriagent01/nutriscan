{
  "name": "nutriscan",
  "version": "1.0.0",
  "description": "App gratuita para escanear etiquetas nutricionales y trackear nutrientes",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "cd client && npx vite",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "node --test server/**/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
