{
  "name": "nutriscan",
  "version": "1.0.0",
  "description": "App gratuita para escanear etiquetas nutricionales y trackear nutrientes",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"npm run dev --prefix client\"",
    "start": "node server/index.js",
    "build": "npm run build --prefix client",
    "test": "node --test server/**/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
